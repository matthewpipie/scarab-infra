      "binary":"scarab_5f06591",
      "slurm_options":"",
      "memory_overhead_mb":64
    },
    "mlp64_16":{
      "_params":"REPL_MLP gamma_i 64, gamma_d 16: google's best in mlp_gamma_google_small",
